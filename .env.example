# Copy this file to .env and fill in real values. .env is never committed (see .gitignore) —
# secrets only ever live on the machine/service that runs the app, never in the repo.

# --- LLM providers (blocs 0-3.5, 6, 7: topic discovery, curriculum, content writing, quality
# control, chatbot, exam generation) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Flask app (bloc4_publication) ---
FLASK_SECRET_KEY=
DATABASE_URL=
LMS_STATE_DIR=
LEGAL_CONTACT_EMAIL=

# --- Google OAuth login (accounts/oauth.py) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payment: Paddle, Merchant of Record (bloc5_payment) ---
PADDLE_API_KEY=
PADDLE_API_BASE=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRODUCT_ID=
PADDLE_PRICE_ID=

# --- Video production (bloc3_video_production): TTS voice + AI-generated visuals ---
ELEVENLABS_API_KEY=
FAL_API_KEY=

# --- Deployment / hosting (Render) ---
RENDER=
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_NOTIFY_EMAIL=

# --- Public identifiers (not secrets, centralized here for a single source of truth) ---
KORTEX_SITE_URL=

# See also marketing/.env.example for the separate marketing automation system's own variables
# (Meta/Facebook/Instagram, Telegram, upload token).
