# Marketing KORTEX — copie ce fichier en marketing/.env et remplis les valeurs.
# marketing/.env n'est JAMAIS commité (voir .gitignore) — les vrais secrets ne vivent que sur
# la machine qui exécute ce système, jamais dans le dépôt git.

# API Anthropic (agent1 : extraction de tip depuis le contenu des cours, agent2 : génération de
# texte pour les 3 canaux)
ANTHROPIC_API_KEY=

# Meta (Facebook + Instagram) — Graph API
# META_PAGE_ACCESS_TOKEN : token d'accès Page (courte durée par défaut, ~1h-2h ; voir
# refresh_long_lived_token() dans agent3_publisher.py pour obtenir un token 60 jours).
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=

# Identifiants publics (pas des secrets, mais centralisés ici pour une seule source de vérité)
FACEBOOK_PAGE_ID=1314210561771540
INSTAGRAM_ACCOUNT_ID=17841434849451752
META_APP_ID=4432218920381007
TELEGRAM_CHANNEL=@kortex_edu

KORTEX_SITE_URL=https://cours.aymen-automation.site

# Authentifie agent3_publisher.py::upload_image_to_kortex auprès de POST /api/upload-image sur le
# site KORTEX (bloc4_publication/app.py) — DOIT avoir exactement la même valeur que
# MARKETING_UPLOAD_TOKEN dans le .env du site KORTEX lui-même (deux déploiements distincts, un seul
# secret partagé).
MARKETING_UPLOAD_TOKEN=
